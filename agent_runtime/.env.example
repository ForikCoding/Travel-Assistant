# ================================
# Qdrant 向量数据库配置 - 获取API密钥：https://cloud.qdrant.io/
# ================================
# 使用Qdrant云服务 (推荐)
QDRANT_URL=https://your-cluster.qdrant.tech:6333
QDRANT_API_KEY=your_qdrant_api_key_here

# 或使用本地Qdrant (需要Docker)
# QDRANT_URL=http://localhost:6333
# QDRANT_API_KEY=

# Qdrant集合配置
QDRANT_COLLECTION=hello_agents_vectors
QDRANT_VECTOR_SIZE=384
QDRANT_DISTANCE=cosine
QDRANT_TIMEOUT=30

# ================================
# Neo4j 图数据库配置 - 获取API密钥：https://neo4j.com/cloud/aura/
# ================================
# 使用Neo4j Aura云服务 (推荐)
NEO4J_URI=neo4j+s://your-instance.databases.neo4j.io
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=your_neo4j_password_here

# 或使用本地Neo4j (需要Docker)
# NEO4J_URI=bolt://localhost:7687
# NEO4J_USERNAME=neo4j
# NEO4J_PASSWORD=hello-agents-password

# Neo4j连接配置
NEO4J_DATABASE=neo4j
NEO4J_MAX_CONNECTION_LIFETIME=3600
NEO4J_MAX_CONNECTION_POOL_SIZE=50
NEO4J_CONNECTION_TIMEOUT=60

# ==========================
# 嵌入（Embedding）配置示例 - 可从阿里云控制台获取：https://dashscope.aliyun.com/
# ==========================
# - 若为空，dashscope 默认 text-embedding-v3；local 默认 sentence-transformers/all-MiniLM-L6-v2
EMBED_MODEL_TYPE=dashscope
EMBED_MODEL_NAME=
EMBED_API_KEY=
EMBED_BASE_URL=

# HuggingFace 下载镜像端点（本地模型下载用）。
# 默认从 huggingface.co 下载，国内网络常超时/被墙；设为 hf-mirror.com 即可正常下载。
# 留空则使用官方默认地址。若已有本地缓存或走代理，可留空。
HF_ENDPOINT=https://hf-mirror.com

# ==========================
# 记忆系统配置（MemoryConfig） - 由 MemoryConfig.from_env() 读取
# ==========================
# 未设置或留空的项使用括号内标注的默认值。
# 注意：这些配置只在「未显式传入 MemoryConfig」时生效
#       （如 MemoryManager(config=None) / MemoryTool(memory_config=None)）。

# --- 存储与向量开关 ---
# SQLite 数据文件所在目录（默认：./memory_data）
MEMORY_STORAGE_PATH=./memory_data
# 是否禁用向量存储，1/true/yes/on 表示禁用（默认：true）
# 置为 false 时启用 Qdrant 向量检索；置为 true 时记忆退化为「纯 SQLite + 文本检索」
MEMORY_DISABLE_VECTOR_STORE=true
# 是否禁用嵌入模型，1/true/yes/on 表示禁用（默认：true）
# 置为 false 时启用 sentence-transformers / dashscope；true 时不加载任何嵌入模型（离线）
MEMORY_DISABLE_EMBEDDINGS=true

# --- 通用容量与评分 ---
# 各记忆类型的最大容量（默认：100）
MEMORY_MAX_CAPACITY=100
# 重要性阈值，低于该值的记忆在 forget 时优先淘汰（默认：0.1）
MEMORY_IMPORTANCE_THRESHOLD=0.1
# 时间衰减因子，每 6 小时衰减一次，取值 (0, 1]（默认：0.95）
MEMORY_DECAY_FACTOR=0.95

# --- 工作记忆 ---
# 工作记忆最大条数（默认：10）
MEMORY_WORKING_CAPACITY=10
# 工作记忆最大 token 数（按空格分词估算，默认：2000）
MEMORY_WORKING_TOKENS=2000
# 工作记忆 TTL，单位分钟，超过则惰性清除（默认：120）
MEMORY_WORKING_TTL_MINUTES=120

# --- 感知记忆 ---
# 支持的模态列表，逗号分隔（默认：text,image,audio,video）
MEMORY_PERCEPTUAL_MODALITIES=text,image,audio,video
